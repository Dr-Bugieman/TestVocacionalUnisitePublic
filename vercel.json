{
  "version": 2,
  "functions": {
    "TestVocacional/*.php": { "runtime": "vercel-php@0.5.2" }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/TestVocacional/assets/$1"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/TestVocacional/$1"
    },
    {
      "src": "^/$",
      "dest": "/TestVocacional/index.php"
    },
    {
      "src": "^/(.*)$",
      "dest": "/TestVocacional/index.php"
    }
  ]
}
