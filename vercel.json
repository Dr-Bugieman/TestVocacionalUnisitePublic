{
  "version": 2,
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.5.2" }
  },
  "routes": [
    {
      "src": "^/api/tutorial.php$",
      "headers": { "Location": "/tutorial" },
      "status": 307
    },
    {
      "src": "^/tutorial$",
      "dest": "/api/tutorial.php"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/(.*\\.(?:png|jpg|jpeg|gif|svg|css|js|ico|woff2|woff|ttf|eot))$",
      "dest": "/public/$1"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
